#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// https://zmk.dev/docs/development/hardware-integration/soft-off-setup?advanced-methods=wakeup&kscan-type=dkscan

/ {
    keys {
        compatible = "gpio-keys";

        soft_off_gpio_key: soft_off_gpio_key { gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
    };

    wakeup_scan: wakeup_scan {
        compatible = "zmk,kscan-gpio-direct";
        input-keys = <&soft_off_gpio_key>;
        wakeup-source;
    };

    side_band_behavior_triggers: side_band_behavior_triggers {
        compatible = "zmk,kscan-sideband-behaviors";
        kscan = <&wakeup_scan>;
        auto-enable;
        wakeup-source;
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&wakeup_scan>;
    };
};

// Layers (higher index wins when several are active)
#define EN     0   // Colemak-DH
#define RU     1   // Statica 3x5 (sends ЙЦУКЕН keycodes: OS layout = standard Russian "PC")
#define ENMOD  2   // EN letters while a modifier is held in RU (Ctrl+C stays Ctrl+C)
#define NUM    3
#define SYM    4
#define RUSYM  5   // SYM while RU is on: punctuation that exists in the Russian layout
#define FUNC   6
#define MOUSE  7
#define WM     8
#define GAME   9
#define GNUM   10

/ {
    chosen { zmk,charmap = &charmap_us; };

    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        // RU home-row mods: hold = modifier + ENMOD layer (shortcuts use English letters)
        hr: hold_tap_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&modl>, <&kp>;
        };

        // tap = letter, hold = its rare twin (ь/ъ, ш/щ)
        lh: hold_letter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <300>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <0>;      // 0
            time-to-max-speed-ms = <40>;      // 500
            delay-ms = <0>;                   // 10
        };
    };

    macros {
        modl: mod_with_en_letters {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_press &kp MACRO_PLACEHOLDER &mo ENMOD>,
                       <&macro_pause_for_release>,
                       <&macro_param_1to1>, <&macro_release &kp MACRO_PLACEHOLDER &mo ENMOD>;
        };

        // language: switch the OS layout (Caps Lock) and the keyboard layout together
        lang: language_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp CAPS &tog RU>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // RU: comma / period = press the two keys above each other (С+Ч, Н+Ш), same spot as , . in EN
        ru_comma  { timeout-ms = <35>; key-positions = <17 27>; layers = <RU>; bindings = <&kp LS(FSLH)>; };
        ru_period { timeout-ms = <35>; key-positions = <18 28>; layers = <RU>; bindings = <&kp FSLH>; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer { if-layers = <NUM SYM>; then-layer = <FUNC>; };
        ru_sym    { if-layers = <RU SYM>;  then-layer = <RUSYM>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer1 {
            display-name = "EN";
            // Colemak-DH, home-row mods: Globe/Alt/Ctrl/Super  ·  Super/Ctrl/Alt/Globe
            bindings = <
  &kp Q        &kp W       &kp F        &kp P       &kp B         &kp J      &kp L        &kp U        &kp Y       &kp SEMI
  &ht GLOBE A  &ht LALT R  &ht LCTRL S  &ht LGUI T  &kp G         &kp M      &ht RGUI N   &ht RCTRL E  &ht RALT I  &ht GLOBE O
  &kp Z        &kp X       &kp C        &kp D       &kp V         &kp K      &kp H        &kp COMMA    &kp DOT     &kp FSLH
                           &lt WM ESC   &lt SYM TAB &kp LSHIFT    &kp SPACE  &lt NUM ENTER &kp BSPC
            >;
        };

        ru_layer {
            display-name = "RU";
            // Statica 3x5. Each key sends the ЙЦУКЕН keycode of its letter. Hold Ь = Ъ, hold Ш = Щ
            //  ь у а ж ю   г б р л х
            //  и е о к я   м т с н з
            //  ф э ы п й   д в ч ш ц
            bindings = <
  &lh RBKT M   &kp E       &kp F        &kp SEMI    &kp DOT       &kp U      &kp COMMA    &kp H        &kp K       &kp LBKT
  &hr GLOBE B  &hr LALT T  &hr LCTRL J  &hr LGUI R  &kp Z         &kp V      &hr RGUI N   &hr RCTRL C  &hr RALT Y  &hr GLOBE P
  &kp A        &kp SQT     &kp S        &kp G       &kp Q         &kp L      &kp D        &kp X        &lh O I     &kp W
                           &trans       &trans      &trans        &trans     &trans       &trans
            >;
        };

        en_mod_layer {
            display-name = "EN (mod held)";
            // active only while a modifier is held from the RU layer
            bindings = <
  &kp Q        &kp W       &kp F        &kp P       &kp B         &kp J      &kp L        &kp U        &kp Y       &kp SEMI
  &ht GLOBE A  &ht LALT R  &ht LCTRL S  &ht LGUI T  &kp G         &kp M      &ht RGUI N   &ht RCTRL E  &ht RALT I  &ht GLOBE O
  &kp Z        &kp X       &kp C        &kp D       &kp V         &kp K      &kp H        &kp COMMA    &kp DOT     &kp FSLH
                           &trans       &trans      &trans        &trans     &trans       &trans
            >;
        };

        right_layer {
            display-name = "NUM & NAV";
            bindings = <
  &kp N1   &kp N2    &kp N3        &kp N4         &kp N5           &kp N6    &kp N7     &kp N8     &kp N9     &kp N0
  &kp DEL  &lang     &kp PSCRN     &kp LC(SPACE)  &kp LC(SPACE)    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
  &trans   &trans    &trans        &trans         &trans           &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &bootloader
                     &kp LC(LEFT)  &kp LC(RIGHT)  &kp ESC          &trans    &trans     &trans
            >;
        };

        left_layer {
            display-name = "SYMBOL";
            bindings = <
  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT          &kp CARET  &kp AMPS   &kp ASTRK  &kp GRAVE  &kp TILDE
  &kp DQT   &kp LBKT  &kp LBRC  &kp LPAR  &default_report    &kp FSLH   &kp MINUS  &kp EQUAL  &kp COLON  &kp SEMI
  &kp SQT   &kp RBKT  &kp RBRC  &kp RPAR  &bootloader        &kp BSLH   &kp UNDER  &kp PLUS   &kp PIPE   &kp QMARK
                      &trans    &trans    &trans             &tog MOUSE &trans     &trans
            >;
        };

        ru_sym_layer {
            display-name = "SYMBOL (RU)";
            // same places as SYMBOL, but keycodes of the Russian layout. Missing there: @ $ ^ & [ ] { } ' | ~
            bindings = <
  &kp LS(N1)  &none       &kp LS(N3)  &none       &kp LS(N5)     &none         &none        &kp LS(N8)     &kp GRAVE   &kp LS(GRAVE)
  &kp LS(N2)  &none       &none       &kp LS(N9)  &trans         &kp LS(BSLH)  &kp MINUS    &kp EQUAL      &kp LS(N6)  &kp LS(N4)
  &none       &none       &none       &kp LS(N0)  &trans         &kp BSLH      &kp LS(MINUS) &kp LS(EQUAL) &none       &kp LS(N7)
                          &trans      &trans      &trans         &trans        &trans       &trans
            >;
        };

        tri_layer {
            display-name = "FUNC";
            bindings = <
  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0    &bt BT_SEL 2  &out OUT_TOG   &tog GAME       &kp C_MUTE    &kp C_PREV
  &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1    &bt BT_SEL 3  &kp C_BRI_UP   &studio_unlock  &kp C_VOL_UP  &kp C_PP
  &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_CLR      &tog RU       &kp C_BRI_DEC  &soft_off       &kp C_VOL_DN  &kp C_NEXT
                   &trans   &trans   &trans          &trans        &trans         &trans
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
  &tog MOUSE  &mkp MB4  &mkp MCLK  &mkp MB5   &trans        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &tog MOUSE
  &trans      &trans    &trans     &trans     &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
  &trans      &trans    &trans     &trans     &trans        &trans          &mkp MB4        &mkp MCLK     &mkp MB5         &trans
                        &trans     &kp SPACE  &kp LSHIFT    &mkp LCLK       &mkp RCLK       &trans
            >;
        };

        windows_layer {
            display-name = "WINDOWS";
            // hold the outer left thumb (Esc). Sends Omarchy/Hyprland Super shortcuts (layout-independent)
            // thumbs: taller / shorter (left), language, wider / narrower (right)
            bindings = <
  &kp LG(N1)      &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)          &kp LG(LC(LS(LEFT)))  &kp LG(LS(TAB))   &kp LG(TAB)     &kp LG(J)        &kp LG(LC(LS(RIGHT)))
  &kp LG(SPACE)   &kp LG(RET)     &kp LG(W)       &kp LG(F)       &kp LG(T)           &kp LG(LEFT)          &kp LG(DOWN)      &kp LG(UP)      &kp LG(RIGHT)    &kp LG(K)
  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))      &kp LG(LS(LEFT))      &kp LG(LS(DOWN))  &kp LG(LS(UP))  &kp LG(LS(RIGHT))  &trans
                                  &trans          &kp LG(LS(EQUAL)) &kp LG(LS(MINUS)) &lang               &kp LG(EQUAL)     &kp LG(MINUS)
            >;
        };

        game_layer {
            display-name = "GAME";
            // on: FUNC + the key under right middle finger, top row. off: right outer thumb. Plain QWERTY, no mods
            bindings = <
  &kp Q      &kp W  &kp E      &kp R      &kp T          &kp Y      &kp U  &kp I      &kp O    &kp P
  &kp A      &kp S  &kp D      &kp F      &kp G          &kp H      &kp J  &kp K      &kp L    &kp SEMI
  &kp Z      &kp X  &kp C      &kp V      &kp B          &kp N      &kp M  &kp COMMA  &kp DOT  &kp ESC
                    &kp LCTRL  &mo GNUM   &kp SPACE      &kp LSHIFT &kp TAB  &tog GAME
            >;
        };

        game_num_layer {
            display-name = "GAME NUM";
            // hold left middle thumb in GAME: numbers / items under the left hand
            bindings = <
  &kp N1     &kp N2  &kp N3   &kp N4  &kp N5         &kp F1   &kp F2   &kp F3   &kp F4   &kp F5
  &kp N6     &kp N7  &kp N8   &kp N9  &kp N0         &kp LEFT &kp DOWN &kp UP   &kp RIGHT &trans
  &kp LALT   &kp ESC &kp TAB  &kp ENTER &kp BSPC     &trans   &trans   &trans   &trans   &trans
                     &trans   &trans  &trans         &trans   &trans   &trans
            >;
        };
    };
};
